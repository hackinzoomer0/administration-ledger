#!/bin/bash
set -euo pipefail
umask 077
root=$(cd -- "$(dirname -- "$0")/.." && pwd)
if [[ "${1:-}" == report ]]; then
    stage=$(realpath -- "${2:?Supply the retained stage}")
    [[ "$stage" == "$root/.runtime/review."* && -f "$stage/application-success.json" ]]
    python3 "$root/scripts/review_chat.py" "$stage" report < "$stage/completion-prompt.txt"
    exit
fi
case "${1:-}" in daily) section=Daily;; weekly) section=Weekly;; *) exit 2;; esac
runtime="$root/.runtime"
mkdir -p "$runtime"
daily_stamp="$runtime/daily-review-success"
review_date=$(TZ=America/Chicago date +%F)
if [[ "$section" == Weekly ]] && [[ $(cat "$daily_stamp" 2>/dev/null || true) != "$review_date" ]]; then
    systemctl --user start ledger-daily-review.service || [[ $(cat "$daily_stamp" 2>/dev/null || true) == "$review_date" ]]
    [[ $(cat "$daily_stamp") == "$review_date" ]]
fi
exec 9>"$runtime/review.lock"
flock -w 1800 9
stage=$(mktemp -d "$runtime/review.XXXXXX")
cleanup() {
    status=$?
    if [[ "$section" == Daily && -f "$stage/application-success.json" ]]; then
        printf '%s\n' "$review_date" > "$daily_stamp"
    fi
    if (( status == 0 )); then
        mkdir -p "$runtime/receipts"
        for receipt in application-success.json publication.json usage.json chat.json intake-receipts.json; do
            [[ ! -f "$stage/$receipt" ]] || cp -- "$stage/$receipt" "$runtime/receipts/$(basename "$stage").$receipt"
        done
        chmod -R go-rwx "$runtime/receipts"
        rm -rf -- "$stage"
    else
        printf 'Review failed; retained diagnostics at %s\n' "$stage" >&2
        if [[ -f "$stage/chat.json" ]]; then
            { printf 'Exit status: %s.\n' "$status"; cat "$root/prompts/execution/failure.md"; } | python3 "$root/scripts/review_chat.py" "$stage" report || true
        fi
    fi
}
trap cleanup EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
python3 "$root/scripts/review_workflow.py" prepare "$stage" "$section"
python3 "$root/scripts/review_chat.py" "$stage" "$section" < "$stage/prompt.txt"
python3 "$root/scripts/review_workflow.py" finish "$stage" "$section"
if [[ "$section" == Daily ]]; then
    printf '%s\n' "$review_date" > "$daily_stamp"
fi
python3 "$root/scripts/review_chat.py" "$stage" report < "$stage/completion-prompt.txt"
